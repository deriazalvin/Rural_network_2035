# =========================================
# CONFIGURATION EXAMPLE - Rural Network 2035
# Copier ce fichier en .env.local et remplir
# =========================================

# ============ BACKEND ============

# Base de données MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=rural_network
MYSQL_USER=rural
MYSQL_PASSWORD=votre_motdepasse_securise

# JWT Authentication
JWT_SECRET=votre-clé-secrète-très-long-et-aléatoire-minimum-32-caracteres
JWT_EXPIRATION=86400000  # 24 heures en millisecondes

# Google Gemini API (Assistant IA)
GEMINI_API_KEY=sk-proj-xxxxxxxxxxxx
GEMINI_MODEL=gemini-pro

# OpenWeatherMap API
WEATHER_API_KEY=votre-cle-openweather
WEATHER_API_URL=https://api.openweathermap.org

# OSRM (Open Source Routing Machine)
OSRM_API_URL=http://router.project-osrm.org
OSRM_TIMEOUT=30000  # millisecondes

# Serveur Spring Boot
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

# JPA/Hibernate
JPA_HIBERNATE_DDL_AUTO=update  # update|validate|create-drop
JPA_SHOW_SQL=false
JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQL8Dialect

# ============ FRONTEND WEB ============

VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_NAME=Rural Network 2035
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Services externes (URLs directes)
VITE_OSRM_API_URL=http://router.project-osrm.org
VITE_NOMINATIM_API_URL=https://nominatim.openstreetmap.org
VITE_WEATHER_API_URL=https://api.openweathermap.org

# ============ MOBILE APP ============

# API Backend pour mobile
REACT_NATIVE_API_HOST=192.168.1.100  # Adresse IP du serveur backend
REACT_NATIVE_API_PORT=8080
REACT_NATIVE_API_PROTOCOL=http

# Expo Configuration
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080/api
EXPO_PUBLIC_ENVIRONMENT=development

# ============ PRODUCTION ============
# À utiliser seulement en production avec des valeurs sécurisées

# PROD_API_BASE_URL=https://api.ruralnetwork.mg
# PROD_DOMAIN=ruralnetwork.mg
# PROD_SSL_CERT=/etc/ssl/certs/certificate.crt
# PROD_ENVIRONMENT=production
