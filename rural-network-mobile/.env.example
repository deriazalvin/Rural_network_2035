# Configuration API - Rural Network Mobile
# Copier ce fichier en .env.local et modifier l'adresse IP selon ton environnement

# IP/Localhost du backend Spring Boot
# - Émulateur Android: 10.0.2.2
# - Appareil WiFi: 192.168.x.x (IP locale de ton PC)
# - iPhone Simulator: 127.0.0.1 ou localhost
# - Docker: 172.17.x.x
EXPO_PUBLIC_API_HOST=192.168.10.150

# Port du backend
EXPO_PUBLIC_API_PORT=8080

# Protocole (http pour dev, https pour prod)
EXPO_PUBLIC_API_PROTOCOL=http

# Timeout requêtes (ms)
EXPO_PUBLIC_API_TIMEOUT=30000

# Environment
EXPO_PUBLIC_ENV=development
