        <mxCell id="xwoXn96NS5rD2Nc5dIMS-34" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;Au lieu&amp;nbsp; de : 0(n²) ,&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&amp;nbsp;on utilise&amp;nbsp;O((V + E) log V)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;(complexité temporelle)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;-Si 0 (n²)&amp;nbsp; : si on double le travail explose ( 0&amp;nbsp; de&amp;nbsp; n&amp;nbsp; carré)&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;O(log n) : élimine chaque moitié à chaque étape&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;- Si&amp;nbsp; 0 ((V + E )&amp;nbsp; log V) : V vertices&amp;nbsp; = sommets / noeuds (village)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;E arête = route&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot; size=&quot;1&quot;&gt;&lt;div style=&quot;&quot;&gt;(Le coût dépend :&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- du nombre de villages&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- du nombre de routes&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- avec une optimisation logarithmique)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Tas Binaire : récupère le min&amp;nbsp;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="265" x="315" y="1110" as="geometry" />
        </mxCell>
