        <mxCell id="xwoXn96NS5rD2Nc5dIMS-33" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=11;" value="&lt;p data-start=&quot;1952&quot; data-end=&quot;1966&quot;&gt;L’algorithme (glouton :&amp;nbsp;&lt;span class=&quot;ͼv&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;implements&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; &lt;/span&gt;&lt;span class=&quot;ͼ11&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;IAlgorithmeOptimisation&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;) :&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;1952&quot; data-end=&quot;1966&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;cherche le village le plus proche&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;1952&quot; data-end=&quot;1966&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;y va&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;1952&quot; data-end=&quot;1966&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;recommence&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;1952&quot; data-end=&quot;1966&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;jusqu’à visiter tous les village&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="210" x="25" y="1140" as="geometry" />
